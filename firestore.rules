rules_version = '2';

// Regras de segurança do SYNTRA — as MESMAS regras de perfil do app
// (src/services/permissoes.ts), aplicadas no servidor. O front-end nunca é a única proteção.
// Especificação: docs/PROPOSTA.md ("LGPD funcionando no back-end, não só na tela").
//
// Duas áreas: TOTEM ("Área do servidor": cada um vê só a própria ficha — aplicado na camada de
// serviços) e PAINEL ("Site do RH"). As regras abaixo são o limite máximo de cada perfil.
//
// Perfis (coleção "usuarios/{uid}", campo "perfil"):
//   servidor → só a PRÓPRIA ficha; envia atualizações (autoatendimento) para aprovação;
//              documentos próprios + "publico-interno"; nunca "sigiloso"
//   gestor   → fichas e documentos da SUA unidade; aprova atualizações da unidade
//              (nunca o próprio pedido)
//   admin    → RH: vê e edita tudo
// Logs: somente inclusão; ninguém edita ou apaga; só o RH lê.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function caminhoEu() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function temPerfil() {
      return logado() && exists(caminhoEu());
    }
    function eu() {
      return get(caminhoEu()).data;
    }
    function isAdmin()    { return temPerfil() && eu().perfil == 'admin'; }
    function isGestor()   { return temPerfil() && eu().perfil == 'gestor'; }
    function isServidor() { return temPerfil() && eu().perfil == 'servidor'; }

    // Matrícula: exatamente 4 dígitos (mesmo formato de src/lib/texto.ts).
    function matriculaValida(v) {
      return v is string && v.matches('^[0-9]{4}$');
    }

    function lotacaoValida(v) {
      return v in ['Superintendência – Teresina', 'Delegacia de Teresina', 'Delegacia de Parnaíba',
                   'Delegacia de Picos', 'Delegacia de Floriano', 'Delegacia de Corrente'];
    }

    // ---------- Usuários ----------
    match /usuarios/{uid} {
      // Cada usuário só lê o próprio registro; o admin lê todos (aba "Usuários").
      allow read: if (logado() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.perfil in ['servidor', 'gestor', 'admin']
        && lotacaoValida(request.resource.data.unidade)
        && matriculaValida(request.resource.data.matricula)
        // O admin não altera o próprio perfil (evita ficar sem administrador por engano).
        && !(uid == request.auth.uid && request.resource.data.perfil != 'admin');
      allow delete: if false;
    }

    // ---------- Autoatendimento: aprovação no mesmo lote ----------
    // Confere que o pedido `idSol` era do servidor `matricula`, estava "pendente" ANTES
    // e fica "aprovada" DEPOIS do lote de gravação (getAfter).
    function caminhoSol(idSol) {
      return /databases/$(database)/documents/solicitacoes/$(idSol);
    }
    function aprovadaNoMesmoLote(idSol, matricula) {
      return idSol is string
        && get(caminhoSol(idSol)).data.status == 'pendente'
        && getAfter(caminhoSol(idSol)).data.status == 'aprovada'
        && getAfter(caminhoSol(idSol)).data.matriculaServidor == matricula;
    }

    // ---------- Servidores (fichas) ----------
    function fichaValida() {
      let s = request.resource.data;
      return matriculaValida(s.matricula)
        && lotacaoValida(s.lotacao)
        // LGPD: nunca guardar CPF completo — só o campo mascarado, no formato ***.000.000-**
        && !('cpf' in s)
        && s.cpfMascarado.matches('^[*]{3}[.][0-9]{3}[.][0-9]{3}-[*]{2}$');
    }

    match /servidores/{id} {
      // Servidor: só a própria ficha · Gestor: só a sua unidade · RH: todas.
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        || (temPerfil() && resource.data.matricula == eu().matricula);
      allow create: if isAdmin() && fichaValida();
      allow update: if (isAdmin() && fichaValida())
        // Gestor: só aplica um pedido APROVADO da sua unidade (curso + data de atualização),
        // nunca na própria ficha e sem tocar em nenhum outro campo.
        || (isGestor()
            && resource.data.lotacao == eu().unidade
            && resource.data.matricula != eu().matricula
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['capacitacoes', 'fichaAtualizadaEm', 'ultimaSolicitacaoAprovada'])
            && aprovadaNoMesmoLote(request.resource.data.ultimaSolicitacaoAprovada, resource.data.matricula));
      allow delete: if false;
    }

    // ---------- Estatísticas agregadas (só números, sem dados pessoais) ----------
    // Ex.: estatisticas/competencias = { contagem: { "Libras": 2, ... } }, usada pelo alerta de
    // risco do gestor para medir raridade sem ler fichas de outras unidades.
    match /estatisticas/{id} {
      allow read: if isGestor() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Solicitações de autoatendimento ----------
    function solicitacaoNovaValida() {
      let s = request.resource.data;
      return s.matriculaServidor == eu().matricula
        && s.lotacao == eu().unidade
        && s.criadaPorUid == request.auth.uid
        && s.status == 'pendente'
        && s.tipo in ['capacitacao', 'documento']
        && s.origem in ['totem', 'painel']
        && !('decididaEm' in s) && !('decididaPorUid' in s) && !('motivoRecusa' in s);
    }

    match /solicitacoes/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        || (temPerfil() && resource.data.matriculaServidor == eu().matricula);
      // Cada um envia pedidos SOMENTE em seu próprio nome, sempre "pendente".
      allow create: if temPerfil() && solicitacaoNovaValida();
      // Decisão: só de "pendente" para "aprovada"/"recusada", registrando quem decidiu.
      // Recusa exige motivo. Gestor: só da sua unidade e nunca o próprio pedido.
      allow update: if resource.data.status == 'pendente'
        && request.resource.data.status in ['aprovada', 'recusada']
        && request.resource.data.decididaPorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decididaEm', 'decididaPorUid', 'decididaPorNome', 'motivoRecusa'])
        && (request.resource.data.status == 'aprovada'
            || (request.resource.data.motivoRecusa is string && request.resource.data.motivoRecusa.size() > 0))
        && (isAdmin()
            || (isGestor()
                && resource.data.lotacao == eu().unidade
                && resource.data.matriculaServidor != eu().matricula));
      allow delete: if false;
    }

    // ---------- Documentos ----------
    function documentoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['titulo', 'tipo', 'numeroProcesso', 'matriculaServidor', 'lotacao',
                              'dataDocumento', 'localizacaoFisica', 'status', 'nivelAcesso'])
        // Nº SEI no formato oficial; vazio só para documentos vindos do autoatendimento.
        && (d.numeroProcesso.matches('^[0-9]{5}[.][0-9]{6}/[0-9]{4}-[0-9]{2}$')
            || (d.numeroProcesso == '' && d.get('origemCadastro', '') == 'autoatendimento'))
        && matriculaValida(d.matriculaServidor)
        && d.status in ['Ativo', 'Arquivado', 'Em tramitação']
        && d.nivelAcesso in ['publico-interno', 'restrito', 'sigiloso']
        && lotacaoValida(d.lotacao)
        && d.localizacaoFisica is string && d.localizacaoFisica.size() >= 5;
    }

    match /documentos/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        // "sigiloso" nunca é retornado para o perfil servidor.
        || (isServidor()
            && resource.data.nivelAcesso in ['publico-interno', 'restrito']
            && (resource.data.matriculaServidor == eu().matricula
                || resource.data.nivelAcesso == 'publico-interno'));
      // Cadastrar, editar e arquivar: somente o RH. Apagar: ninguém (usa-se "arquivar").
      allow create, update: if isAdmin() && documentoValido();
      // Gestor: só cria o comprovante de um pedido APROVADO da sua unidade (mesmo lote),
      // sempre restrito, sem nº de processo e nunca para si mesmo.
      allow create: if isGestor()
        && documentoValido()
        && request.resource.data.origemCadastro == 'autoatendimento'
        && request.resource.data.nivelAcesso == 'restrito'
        && request.resource.data.numeroProcesso == ''
        && request.resource.data.lotacao == eu().unidade
        && request.resource.data.matriculaServidor != eu().matricula
        && aprovadaNoMesmoLote(request.resource.data.solicitacaoId, request.resource.data.matriculaServidor);
      allow delete: if false;
    }

    // ---------- Processos ----------
    match /processos/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        || (isServidor() && resource.data.matriculaServidor == eu().matricula);
      allow create: if isAdmin();
      // Gestor da unidade pode registrar movimentações (histórico, unidade atual e situação).
      allow update: if isAdmin()
        || (isGestor()
            && resource.data.lotacao == eu().unidade
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['historico', 'unidadeAtual', 'situacao']));
      allow delete: if false;
    }

    // ---------- Extratos da ficha (impressos no totem) ----------
    // O documento guarda SÓ os campos de verificação (nome, matrícula, data, seções): como o
    // Firestore não esconde campos num documento legível, nada além disso é gravado.
    function codigoExtratoValido(c) {
      return c.matches('^SYN-[A-HJ-KM-NP-Z2-9]{4}-[A-HJ-KM-NP-Z2-9]{4}$');
    }
    match /extratos/{codigo} {
      // Verificação PÚBLICA (página /verificar), só pelo código exato. Listar/enumerar: proibido.
      allow get: if codigoExtratoValido(codigo);
      allow list: if false;
      // Cada um emite extrato SOMENTE da própria ficha.
      allow create: if temPerfil()
        && codigoExtratoValido(codigo)
        && request.resource.data.keys().hasOnly(['matriculaServidor', 'nomeServidor', 'emitidoEm', 'secoes'])
        && request.resource.data.matriculaServidor == eu().matricula
        && request.resource.data.nomeServidor is string
        && request.resource.data.emitidoEm is string
        && request.resource.data.secoes is list
        && request.resource.data.secoes.size() > 0
        && request.resource.data.secoes.hasOnly(['dados', 'lotacao', 'aposentadoria', 'cursos', 'competencias']);
      allow update, delete: if false;
    }

    // ---------- Logs de acesso (LGPD) ----------
    match /logs/{id} {
      // Qualquer usuário com perfil registra SEUS PRÓPRIOS acessos, com o horário real do servidor.
      allow create: if temPerfil()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acao in ['consulta', 'visualizacao', 'download', 'edicao', 'impressao', 'login', 'logout']
        && request.resource.data.origem in ['totem', 'painel']
        && request.resource.data.registradoEm == request.time;
      allow read: if isAdmin();
      // Logs nunca são editados nem apagados.
      allow update, delete: if false;
    }

    // Qualquer outra coleção: bloqueada.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
