rules_version = '2';

// Regras de segurança do SYNTRA — as MESMAS regras de perfil do app
// (src/services/permissoes.ts), aplicadas no servidor. O front-end nunca é a única proteção.
//
// Perfis (coleção "usuarios/{uid}", campo "perfil"):
//   servidor → próprios documentos + documentos "publico-interno"; nunca "sigiloso"
//   gestor   → documentos da sua unidade (campo "lotacao")
//   admin    → lê e escreve tudo
// Logs: somente inclusão; ninguém edita ou apaga; só admin lê.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function caminhoEu() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function temPerfil() {
      return logado() && exists(caminhoEu());
    }
    function eu() {
      return get(caminhoEu()).data;
    }
    function isAdmin()    { return temPerfil() && eu().perfil == 'admin'; }
    function isGestor()   { return temPerfil() && eu().perfil == 'gestor'; }
    function isServidor() { return temPerfil() && eu().perfil == 'servidor'; }

    function lotacaoValida(v) {
      return v in ['Superintendência – Teresina', 'Delegacia de Teresina', 'Delegacia de Parnaíba',
                   'Delegacia de Picos', 'Delegacia de Floriano', 'Delegacia de Corrente'];
    }

    // ---------- Usuários ----------
    match /usuarios/{uid} {
      // Cada usuário só lê o próprio registro; o admin lê todos (aba "Usuários").
      allow read: if (logado() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.perfil in ['servidor', 'gestor', 'admin']
        && lotacaoValida(request.resource.data.unidade)
        && request.resource.data.matricula is string
        // O admin não altera o próprio perfil (evita ficar sem administrador por engano).
        && !(uid == request.auth.uid && request.resource.data.perfil != 'admin');
      allow delete: if false;
    }

    // ---------- Servidores ----------
    match /servidores/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        || (isServidor() && resource.data.matricula == eu().matricula);
      allow create, update: if isAdmin()
        && lotacaoValida(request.resource.data.lotacao)
        // LGPD: nunca guardar CPF completo — só o campo mascarado, no formato ***.000.000-**
        && !('cpf' in request.resource.data)
        && request.resource.data.cpfMascarado.matches('^[*]{3}[.][0-9]{3}[.][0-9]{3}-[*]{2}$');
      allow delete: if false;
    }

    // ---------- Documentos ----------
    function documentoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['titulo', 'tipo', 'numeroProcesso', 'matriculaServidor', 'lotacao',
                              'dataDocumento', 'localizacaoFisica', 'status', 'nivelAcesso'])
        && d.numeroProcesso.matches('^[0-9]{5}[.][0-9]{6}/[0-9]{4}-[0-9]{2}$')
        && d.status in ['Ativo', 'Arquivado', 'Em tramitação']
        && d.nivelAcesso in ['publico-interno', 'restrito', 'sigiloso']
        && lotacaoValida(d.lotacao)
        && d.localizacaoFisica is string && d.localizacaoFisica.size() >= 5;
    }

    match /documentos/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        // "sigiloso" nunca é retornado para o perfil servidor.
        || (isServidor()
            && resource.data.nivelAcesso in ['publico-interno', 'restrito']
            && (resource.data.matriculaServidor == eu().matricula
                || resource.data.nivelAcesso == 'publico-interno'));
      // Cadastrar, editar e arquivar: somente admin. Apagar: ninguém (usa-se "arquivar").
      allow create, update: if isAdmin() && documentoValido();
      allow delete: if false;
    }

    // ---------- Processos ----------
    match /processos/{id} {
      allow read: if isAdmin()
        || (isGestor() && resource.data.lotacao == eu().unidade)
        || (isServidor() && resource.data.matriculaServidor == eu().matricula);
      allow create: if isAdmin();
      // Gestor da unidade pode registrar movimentações (histórico, unidade atual e situação).
      allow update: if isAdmin()
        || (isGestor()
            && resource.data.lotacao == eu().unidade
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['historico', 'unidadeAtual', 'situacao']));
      allow delete: if false;
    }

    // ---------- Logs de acesso (LGPD) ----------
    match /logs/{id} {
      // Qualquer usuário com perfil registra SEUS PRÓPRIOS acessos, com o horário real do servidor.
      allow create: if temPerfil()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acao in ['consulta', 'visualizacao', 'download', 'edicao', 'login', 'logout']
        && request.resource.data.origem in ['totem', 'painel']
        && request.resource.data.registradoEm == request.time;
      allow read: if isAdmin();
      // Logs nunca são editados nem apagados.
      allow update, delete: if false;
    }

    // Qualquer outra coleção: bloqueada.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
