# Copie este arquivo para .env e preencha com as credenciais do projeto Firebase.
# Nunca faça commit do .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fonte de dados: "firebase", "local" (demonstração no navegador, sem Firebase) ou
# "sharepoint" (ainda não implementado: o site mostra "Integração com SharePoint prevista").
# Veja docs/SHAREPOINT.md.
# Se ficar vazio, usa firebase quando as variáveis acima estiverem preenchidas; senão, local.
VITE_DATA_PROVIDER=

# Apenas para o script "npm run seed" (Node, fora do navegador): caminho da chave
# de conta de serviço baixada no Console do Firebase. NUNCA faça commit desse arquivo.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
